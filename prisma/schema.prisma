generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  avatarColor  String   @default("#e11d48")
  createdAt    DateTime @default(now())

  progress  WatchProgress[]
  favorites Favorite[]
  comments  Comment[]
}

model WatchProgress {
  id              String   @id @default(cuid())
  userId          String
  anilistId       Int
  episode         Int
  progressSeconds Float    @default(0)
  durationSeconds Float    @default(0)
  completed       Boolean  @default(false)
  // Snapshot of display info so "Continue Watching" renders without hitting AniList
  title           String
  coverImage      String
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, anilistId, episode])
  @@index([userId, updatedAt])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  anilistId  Int
  title      String
  coverImage String
  addedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, anilistId])
}

model Comment {
  id        String   @id @default(cuid())
  userId    String
  anilistId Int
  episode   Int?
  body      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([anilistId, episode, createdAt])
}

model LibrarySeries {
  id         String   @id @default(cuid())
  folderName String   @unique
  anilistId  Int?
  title      String?
  coverImage String?
  scannedAt  DateTime @default(now())

  episodes LibraryEpisode[]

  @@index([anilistId])
}

model LibraryEpisode {
  id           String  @id @default(cuid())
  seriesId     String
  episode      Int
  relativePath String
  subtitlePath String?
  sizeBytes    Int     @default(0)

  series LibrarySeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([seriesId, episode])
}
