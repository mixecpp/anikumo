DATABASE_URL="file:./dev.db"

# Secret used to sign login sessions (randomly generated).
AUTH_SECRET="3131004d1f773400b8a5dea87fc88574edc07b1add7a7fef4b7f98984bd649f1"

# OPTIONAL local library — off when empty. To enable, point at a folder with one subfolder per series, e.g.
#   LIBRARY_DIR='D:\Anime'   containing   Frieren [154587]\Frieren - 01.mkv
# Keep Windows paths in SINGLE quotes (double quotes turn \r, \n etc. into control characters).
LIBRARY_DIR=''

# Optional: free YouTube Data API v3 key for official free episodes (Muse Asia, Ani-One, etc.)
# Get one at https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=""

# Comma-separated usernames that get the /admin dashboard (reports, errors, password resets).
ADMIN_USERNAMES="mixe"

# Public URL of the site (used in calendar feeds, Discord alerts, sitemap).
APP_URL="http://localhost:8080"

